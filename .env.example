# Job Atlas creates a private local SQLite database by default. Advanced users
# can point it at an existing PostgreSQL database instead.
# JOB_ATLAS_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Private user data lives outside the repository by default. Override these
# only when you intentionally keep configuration elsewhere.
# JOB_ATLAS_HOME=/absolute/path/to/private-job-atlas-data
# RESUME_MASTER_PATH=/absolute/path/to/resume-master.yaml

# Collection window and decision-run policy.
RECENCY_WINDOW_DAYS=60
PIPELINE_INPUT_TIMEZONE=Asia/Kolkata
DECISION_POLICY_VERSION=1

# Decision and company-screening thresholds.
GLASSDOOR_WLB_MIN_REVIEWS=50
FRESH_OUTREACH_SUCCESS_THRESHOLD=4
DAILY_FRESH_COMPANY_TARGET=30
DELIVERY_PRESUMPTION_MINUTES=30
CALIBRATION_WINDOW_MINUTES=60
CALIBRATION_POLL_MINUTES=10

# Inbox used only for the pipeline's self-addressed approval and completion
# reports. Outreach recipients are handled separately and are never sent to
# automatically.
SELF_EMAIL=you@example.com

# Public-search contact discovery. Browser is the default transport; Serper is
# an optional API transport/fallback.
SEARCH_TRANSPORT=browser
SERP_MAX_PAGES=3
SERPER_API_KEY=

# Optional Bright Data SERP transport used by agent-driven contact research.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_API_KEY2=
BRIGHT_DATA_ZONE=serp_api1

# Private ntfy topic for immediate full-pipeline failure/completion alerts.
FULL_PIPELINE_NTFY_TOPIC=

# Optional dedicated Chrome profile for the attended Indeed connector.
# INDEED_PROFILE_DIR=/absolute/path/to/indeed-profile
